# ── Stores: the leaf level, linking geography back to the products ───────────
# Each store carries its own address, not its city's coordinates: a store that
# sits exactly where its city does makes the drill from city to store look like
# nothing happened. Several cities hold more than one.
gear:Store a owl:Class ; rdfs:label "Store"@en ; rdfs:subClassOf gear:Place .
gear:FlagshipStore a owl:Class ; rdfs:label "Flagship Store"@en ; rdfs:subClassOf gear:Store .

gear:stocks a owl:ObjectProperty ; rdfs:label "stocks"@en ;
    rdfs:domain gear:Store ; rdfs:range gear:Product .
gear:specialisesIn a owl:ObjectProperty ; rdfs:label "specialises in"@en ;
    rdfs:domain gear:Store ; rdfs:range skos:Concept .

gear:store-paris-rivoli a owl:NamedIndividual, gear:FlagshipStore ;
    rdfs:label "Rivoli Flagship"@en ; gear:withinArea gear:Paris ;
    wgs:lat "48.862" ; wgs:long "2.3364" ;
    gear:stocks gear:tent-aeon2, gear:jacket-storm ; gear:specialisesIn gear:Waterproof ;
    gear:turnover "2450000"^^xsd:decimal ;
    gear:employees "24"^^xsd:integer ;
    gear:floorArea "820"^^xsd:integer .

gear:store-paris-bastille a owl:NamedIndividual, gear:Store ;
