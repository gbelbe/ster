@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix gear: <https://example.org/gear#> .

# ─────────────────────────────────────────────────────────────────────────────
# Outdoor Gear — a mixed SKOS + OWL demo
#
# What to try in ster:
#   • The Taxonomy shows a theme scheme; puns (Tent, Backpack) render ◉ with their
#     OWL subclasses bridged in under them. Pure classes (Jacket) stay in Ontology.
#   • Right-click a plain concept (Camping / Waterproof) → "Promote to class".
#   • Right-click a pun (Tent) → "Demote to concept".
#   • Right-click an individual → "Tag with concept…" (try the untagged Summit 50L).
#   • Right-click a concept (Waterproof) → "Tag individuals…" to bulk-tag several.
# ─────────────────────────────────────────────────────────────────────────────

gear: a owl:Ontology ;
    rdfs:label "Outdoor Gear — mixed SKOS + OWL demo"@en ;
    rdfs:comment "Blends a SKOS theme taxonomy with an OWL product ontology: puns, a bridged class hierarchy, and individuals tagged by theme."@en .

# ── SKOS taxonomy: browsable product themes ──────────────────────────────────
gear:themes a skos:ConceptScheme ;
    skos:prefLabel "Product Themes"@en ;
    skos:hasTopConcept gear:Outdoor .

gear:Outdoor a skos:Concept ;
    skos:prefLabel "Outdoor"@en ;
    skos:topConceptOf gear:themes ;
    skos:narrower gear:Camping, gear:Hiking, gear:WaterSports, gear:Waterproof .

gear:Camping a skos:Concept ; skos:prefLabel "Camping"@en ; skos:broader gear:Outdoor .
gear:Hiking a skos:Concept ; skos:prefLabel "Hiking"@en ; skos:broader gear:Outdoor .
gear:WaterSports a skos:Concept ; skos:prefLabel "Water Sports"@en ; skos:broader gear:Outdoor .
gear:Waterproof a skos:Concept ; skos:prefLabel "Waterproof"@en ; skos:broader gear:Outdoor .

# ── Puns: a theme that is ALSO a formal product class ────────────────────────
# Both a skos:Concept (a browsable category) and an owl:Class (a type with
# subclasses + individuals). These render ◉ and merge the two hierarchies.
gear:Tent a skos:Concept, owl:Class ;
    skos:prefLabel "Tent"@en ; rdfs:label "Tent"@en ;
    skos:broader gear:Camping ;
    rdfs:subClassOf gear:Product .

gear:Backpack a skos:Concept, owl:Class ;
    skos:prefLabel "Backpack"@en ; rdfs:label "Backpack"@en ;
    skos:broader gear:Hiking ;
    rdfs:subClassOf gear:Product .

# ── OWL ontology: the product class hierarchy ────────────────────────────────
gear:Product a owl:Class ; rdfs:label "Product"@en .

# Pure subclasses of the puns — these bridge up under Tent / Backpack in the tree.
gear:DomeTent a owl:Class ; rdfs:label "Dome Tent"@en ; rdfs:subClassOf gear:Tent .
gear:TunnelTent a owl:Class ; rdfs:label "Tunnel Tent"@en ; rdfs:subClassOf gear:Tent .
gear:DayPack a owl:Class ; rdfs:label "Day Pack"@en ; rdfs:subClassOf gear:Backpack .

# A pure class with no concept twin — stays in the Ontology section.
gear:Jacket a owl:Class ; rdfs:label "Jacket"@en ; rdfs:subClassOf gear:Product .

# ── Individuals: actual products, typed by class + tagged by theme ───────────
gear:tent-aeon2 a owl:NamedIndividual, gear:DomeTent ;
    rdfs:label "Aeon 2P Dome"@en ;
    dct:subject gear:Camping, gear:Waterproof .

gear:tent-vega4 a owl:NamedIndividual, gear:TunnelTent ;
    rdfs:label "Vega 4P Tunnel"@en ;
    dct:subject gear:Camping .

gear:pack-trail30 a owl:NamedIndividual, gear:DayPack ;
    rdfs:label "Trail 30L"@en ;
    dct:subject gear:Hiking .

gear:jacket-storm a owl:NamedIndividual, gear:Jacket ;
    rdfs:label "Storm Shell"@en ;
    dct:subject gear:Waterproof, gear:Hiking .

# An untagged product — use it to try the "Tag with concept…" action.
gear:pack-summit50 a owl:NamedIndividual, gear:DayPack ;
    rdfs:label "Summit 50L"@en .

# ─────────────────────────────────────────────────────────────────────────────
# Retail geography — a class hierarchy, drawn level by level
#
# The map drills by CLASS, not by name: gear:Place has subclasses Continent →
# BusinessArea → Country → City, and every place is an individual of one of them.
# The map shows one level at a time and descends when you click a shape or zoom
# in, so adding a level to the ontology adds a level to the map with no code
# change.
#
#   Continent      Europe                          outline
#   BusinessArea   Northern / Western / …          outline
#   Country        France, Italy, Sweden, …        outline
#   City           Paris, Milan, Kraków, …         point
#
# gear:withinArea carries the containment; stores hang off cities and link back
# into the product ontology. Geometry is attached directly to each individual —
# ster does not preserve bare geometry nodes, see test_concept_annotations.py.
# ─────────────────────────────────────────────────────────────────────────────

@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix wgs:  <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix schema: <https://schema.org/> .
@prefix ster:   <https://ster.dev/ns/map#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ── The levels, as a class hierarchy ─────────────────────────────────────────
gear:Place a owl:Class ; rdfs:label "Place"@en .
gear:Continent a owl:Class ; rdfs:label "Continent"@en ; rdfs:subClassOf gear:Place .
gear:BusinessArea a owl:Class ; rdfs:label "Business Area"@en ; rdfs:subClassOf gear:Place .
gear:Country a owl:Class ; rdfs:label "Country"@en ; rdfs:subClassOf gear:Place .
gear:City a owl:Class ; rdfs:label "City"@en ; rdfs:subClassOf gear:Place .

gear:withinArea a owl:ObjectProperty ; rdfs:label "within area"@en ;
    rdfs:domain gear:Place ; rdfs:range gear:Place .

# Facts a place carries about itself — shown in the map's detail panel alongside
# its relations, and the reason schema:image / schema:url appear on cities below.
gear:population a owl:DatatypeProperty ; rdfs:label "population"@en ;
    rdfs:domain gear:City ; rdfs:range xsd:integer .
gear:founded a owl:DatatypeProperty ; rdfs:label "founded"@en ;
    rdfs:domain gear:Place ; rdfs:range xsd:string .
gear:timezone a owl:DatatypeProperty ; rdfs:label "timezone"@en ;
    rdfs:domain gear:Place ; rdfs:range xsd:string .

# Numbers roll up: the map totals every numeric property of the individuals under
# whatever you have open, so a country shows its turnover without any triple
# stating one.
gear:turnover a owl:DatatypeProperty ; rdfs:label "turnover (EUR)"@en ;
    rdfs:domain gear:Store ; rdfs:range xsd:decimal .
gear:employees a owl:DatatypeProperty ; rdfs:label "employees"@en ;
    rdfs:domain gear:Store ; rdfs:range xsd:integer .
gear:floorArea a owl:DatatypeProperty ; rdfs:label "floor area (m²)"@en ;
    rdfs:domain gear:Store ; rdfs:range xsd:integer .

# ── Continent ────────────────────────────────────────────────────────────────
gear:Europe a owl:NamedIndividual, gear:Continent ;
    rdfs:label "Europe"@en ;
    geo:asWKT "POLYGON((-9.5 36.0, -9.5 43.8, -4.0 43.9, -1.8 46.5, -4.8 48.5, -1.0 49.9, 2.0 51.2, 4.3 53.5, 8.5 54.9, 10.6 57.7, 12.9 56.0, 15.0 56.2, 18.0 59.5, 21.0 60.5, 24.5 60.0, 28.0 59.5, 31.5 55.0, 30.5 50.5, 29.7 45.4, 28.0 41.5, 23.7 38.0, 18.5 40.1, 15.6 38.0, 12.5 37.9, 9.0 39.2, 3.2 39.6, -0.5 38.3, -5.6 36.0, -9.5 36.0))"^^geo:wktLiteral .

# ── Business areas: grouping only, deliberately without geometry ─────────────
# They exist for the taxonomy and the "cluster by" control, but carry no outline:
# a box drawn round a single country is noise next to that country's real shape.
# The map skips a level nothing is drawn at, so the drill reads
# Europe → country → city.
gear:NorthernEurope a owl:NamedIndividual, gear:BusinessArea ;
    rdfs:label "Northern Europe"@en ; gear:withinArea gear:Europe .

gear:WesternEurope a owl:NamedIndividual, gear:BusinessArea ;
    rdfs:label "Western Europe"@en ; gear:withinArea gear:Europe .

gear:SouthernEurope a owl:NamedIndividual, gear:BusinessArea ;
    rdfs:label "Southern Europe"@en ; gear:withinArea gear:Europe .

gear:EasternEurope a owl:NamedIndividual, gear:BusinessArea ;
    rdfs:label "Eastern Europe"@en ; gear:withinArea gear:Europe .

# ── Countries ────────────────────────────────────────────────────────────────
gear:France a owl:NamedIndividual, gear:Country ;
    rdfs:label "France"@en ; gear:withinArea gear:WesternEurope ;
    geo:asWKT "POLYGON((-4.8 48.5, -1.9 48.6, -1.3 49.7, 1.6 51.0, 2.6 51.1, 4.2 49.9, 5.9 49.5, 7.6 49.1, 7.6 47.6, 6.0 46.2, 7.0 45.2, 7.5 43.8, 4.8 43.4, 3.0 43.0, 0.7 42.8, -1.4 43.3, -1.8 46.3, -2.2 47.1, -4.8 48.5))"^^geo:wktLiteral .

gear:Italy a owl:NamedIndividual, gear:Country ;
    rdfs:label "Italy"@en ; gear:withinArea gear:SouthernEurope ;
    geo:asWKT "POLYGON((7.0 45.9, 8.6 46.5, 10.4 46.9, 12.4 46.7, 13.6 46.5, 13.1 45.6, 12.3 45.4, 14.0 44.0, 15.4 42.0, 16.2 41.9, 17.9 40.7, 18.5 40.1, 17.2 39.0, 16.6 38.8, 15.9 37.9, 15.2 38.3, 15.6 39.9, 14.0 40.6, 12.2 41.3, 10.5 42.9, 9.9 44.0, 8.2 44.3, 7.5 44.1, 7.0 45.9))"^^geo:wktLiteral .

gear:Sweden a owl:NamedIndividual, gear:Country ;
    rdfs:label "Sweden"@en ; gear:withinArea gear:NorthernEurope ;
    geo:asWKT "POLYGON((11.2 58.9, 11.5 59.8, 12.9 60.5, 14.5 63.0, 16.0 65.8, 18.0 66.5, 20.0 68.4, 23.2 68.0, 24.2 65.8, 21.5 63.6, 19.0 61.5, 17.9 60.6, 17.0 58.8, 16.5 57.0, 14.5 56.2, 12.9 55.4, 12.5 56.3, 11.2 58.9))"^^geo:wktLiteral .

gear:Poland a owl:NamedIndividual, gear:Country ;
    rdfs:label "Poland"@en ; gear:withinArea gear:EasternEurope ;
    geo:asWKT "POLYGON((14.2 53.9, 16.4 54.6, 18.5 54.8, 19.7 54.4, 22.8 54.4, 23.5 53.9, 23.9 52.3, 23.6 51.5, 23.6 50.4, 22.6 49.5, 20.9 49.3, 19.5 49.6, 17.7 50.0, 16.9 50.4, 15.0 50.9, 14.7 52.0, 14.2 53.9))"^^geo:wktLiteral .

gear:Spain a owl:NamedIndividual, gear:Country ;
    rdfs:label "Spain"@en ; gear:withinArea gear:SouthernEurope ;
    geo:asWKT "POLYGON((-9.3 43.0, -7.0 43.7, -4.5 43.4, -1.8 43.4, -0.3 42.8, 0.7 42.7, 3.2 42.4, 2.1 41.2, 0.9 40.7, 0.0 39.5, -0.3 38.5, -1.6 37.4, -4.4 36.7, -6.3 36.2, -7.4 37.2, -7.0 38.2, -7.2 39.7, -6.9 41.0, -8.2 42.1, -9.3 43.0))"^^geo:wktLiteral .

# ── Cities ───────────────────────────────────────────────────────────────────
gear:Paris a owl:NamedIndividual, gear:City ;
