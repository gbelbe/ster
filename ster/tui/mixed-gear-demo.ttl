# ── Overlay layers offered in the map's layer menu ───────────────────────────
# Declared here rather than in ster: which context is useful is a property of
# the data being mapped. Both of these are key-free — a service needing an API
# key would put that key in the page, which is a decision for whoever publishes.
gear:layer-terrain a ster:MapLayer ;
    rdfs:label "Terrain"@en ;
    ster:tileUrl "https://a.tile.opentopomap.org/{z}/{x}/{y}.png" ;
    ster:attribution "© OpenTopoMap (CC-BY-SA)" ;
    ster:opacity "0.7" .

gear:layer-satellite a ster:MapLayer ;
    rdfs:label "Satellite"@en ;
    ster:tileUrl "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}" ;
    ster:attribution "Esri, Maxar, Earthstar Geographics" ;
    ster:opacity "0.85" .

# ── Layers needing an API key ────────────────────────────────────────────────
# The ontology names the environment variable, never the key: this file is
# committed and shared, and a key written here would be published with it. Set
# OPENWEATHER_API_KEY before starting ster and these appear in the layer menu;
# leave it unset and they are simply absent.
#
# Note the key still reaches the browser in the tile URL, which is fine for a map
# served on localhost and is not for a published one — that wants a server-side
# tile proxy instead.
gear:layer-owm-precip a ster:MapLayer ;
    rdfs:label "Rain (OpenWeather)"@en ;
    ster:tileUrl "https://tile.openweathermap.org/map/precipitation_new/{z}/{x}/{y}.png?appid={env:OPENWEATHER_API_KEY}" ;
    ster:attribution "© OpenWeather" ;
    ster:opacity "0.6" .

gear:layer-owm-clouds a ster:MapLayer ;
    rdfs:label "Clouds (OpenWeather)"@en ;
    ster:tileUrl "https://tile.openweathermap.org/map/clouds_new/{z}/{x}/{y}.png?appid={env:OPENWEATHER_API_KEY}" ;
    ster:attribution "© OpenWeather" ;
    ster:opacity "0.5" .

gear:layer-owm-wind a ster:MapLayer ;
    rdfs:label "Wind (OpenWeather)"@en ;
    ster:tileUrl "https://tile.openweathermap.org/map/wind_new/{z}/{x}/{y}.png?appid={env:OPENWEATHER_API_KEY}" ;
    ster:attribution "© OpenWeather" ;
    ster:opacity "0.5" .

# ── WMS layers ───────────────────────────────────────────────────────────────
# Most public geodata is WMS rather than {z}/{x}/{y} tiles: national weather
# services, environment agencies, everything under INSPIRE. Naming the WMS layer
# is what selects that request shape; the endpoint itself is a plain URL.
#
# The Deutscher Wetterdienst publishes its ICON forecast model openly — no key,
# no registration. Coverage is global on the reg025 grid despite the source being
# a national service.
gear:layer-dwd-temp a ster:MapLayer ;
    rdfs:label "Air temperature 2m (DWD ICON)"@en ;
    ster:tileUrl "https://maps.dwd.de/geoserver/dwd/wms" ;
    ster:wmsLayers "dwd:Icon_reg025_fd_sl_T2M" ;
    ster:attribution "© Deutscher Wetterdienst — ICON" ;
    # DWD's own legend runs from below -60 °C in twenty-odd rows, which is a
    # strip taller than the map. These are that style's real colours, sampled
    # from it and trimmed to the range weather actually occupies. They are not
    # a choice: maps.dwd.de answers a restyling request with "Dynamic style
    # usage is forbidden", so the bar must show what the server paints.
    ster:legendScale "-30:#7a0177, -20:#0570b0, -10:#bdc9e1, 0:#c7e9b4, 10:#fed976, 20:#fd8d3c, 30:#e31a1c, 40:#b10026" ;
    ster:legendUnit "°" ;
    ster:opacity "0.65" .

# 24-hour accumulated precipitation, in millimetres. A 24h accumulation has
# nothing to show until 24h into the forecast, so the server's default time step
# is empty and the date must be asked for ahead — {date:+2d} resolves at request
# time, which a date written here would not. (The Icon-eps layer of the same
# name renders ensemble probabilities in %, not millimetres.)
gear:layer-dwd-rain a ster:MapLayer ;
    rdfs:label "24h accumulated precipitation (DWD ICON)"@en ;
    ster:tileUrl "https://maps.dwd.de/geoserver/dwd/wms?time={date:+2d}" ;
    ster:wmsLayers "dwd:Icon_reg025_fd_sl_TOTPREC24H" ;
    ster:attribution "© Deutscher Wetterdienst — ICON" ;
    ster:opacity "0.65" .
